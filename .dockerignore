# Only exclude things that are never runtime input. Local configs, custom
# files, caches and .env are intentionally NOT excluded, so local
# `docker build`s keep baking them in exactly like before.

# VCS / CI
.git
.github
.husky

# Dependencies & build output (both are rebuilt inside the image)
node_modules
**/node_modules
dist
dist-*
.eslintcache

# Docs & editor files
docs
*.md
.idea
.vscode
.DS_Store
docker-compose*.yml
Dockerfile
.dockerignore
